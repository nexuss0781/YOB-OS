{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/trpc/:trpcPath*",
      "destination": "/api/trpc?trpcPath=:trpcPath*"
    }
  ]
}
